# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA AGENTE BUYERS - INBESTIGA
# Copia este archivo como .env y ajusta los valores de tu entorno.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS SQL SERVER (OLTP: INBESTIGA_TESIS)
# ------------------------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=INBESTIGA_TESIS
DB_USER=sa
DB_PASSWORD=TuPassword123*
DB_TRUST_SERVER_CERTIFICATE=true

# Driver ODBC para Python (Streamlit)
# Ejemplos habituales en Windows:
# - ODBC Driver 17 for SQL Server
# - SQL Server
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ------------------------------------------------------------------------------
# 2. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI - 100% GRATIS)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratis en: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyTuClaveDeGoogleAqui
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# (Opcional) Si en el futuro usas Grok o xAI:
# XAI_API_KEY=xai-tu-api-key-aqui
# XAI_MODEL=grok-2-latest

