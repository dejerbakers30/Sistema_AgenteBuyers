# ==============================================================================
# .gitignore - INBESTIGA: PROTOTIPO FASE BUYER
# ==============================================================================

# 1. Variables de entorno y secretos
.env
.env.local
.env.*.local
*.env
!.env.example
.streamlit/secrets.toml

# 2. Sesión y caché de WhatsApp (whatsapp-web.js)
# ¡CRÍTICO! Contiene tokens y llaves criptográficas de la sesión de WhatsApp vinculada.
.wwebjs_auth/
.wwebjs_cache/

# 3. Dependencias y logs de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 4. Entornos virtuales y caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales (venv, conda)
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# 5. IDEs, editores y sistema operativo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log

